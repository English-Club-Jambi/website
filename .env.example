# Convex cloud. `npx convex dev --configure existing --dev-deployment cloud`
# writes CONVEX_DEPLOYMENT and CONVEX_URL for the selected development deployment.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Convex Auth deployment variables are set with `npx convex env set`, not
# exposed to the Next.js browser bundle. Generate JWT_PRIVATE_KEY and JWKS as a
# matching pair; see SETUP.md. SITE_URL is the browser origin allowed by Auth.
# SITE_URL=http://localhost:3987
# JWT_PRIVATE_KEY=
# JWKS=

# Public canonical and media origins. Keep NEXT_PUBLIC_SITE_URL on the stable
# HTTPS production origin even while developing locally; Auth SITE_URL remains
# the exact browser origin used for that deployment.
NEXT_PUBLIC_SITE_URL=https://englishclub.mukhtada.my.id
NEXT_PUBLIC_MEDIA_BASE_URL=https://r2.mukhtada.my.id

# Optional search-engine ownership tokens. Add the values issued by Google
# Search Console and Bing Webmaster Tools; never paste HTML tags here.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional development-only, comma-separated exact origins for phones or QA
# hosts that aren't one of the machine's detected IPv4 interfaces. Wildcards,
# credentials, paths, query strings, and fragments are rejected.
# NEXT_ALLOWED_DEV_ORIGINS=http://192.168.1.20:3987,qa-phone.local

# R2 S3 credentials. Copy the five values used by convex/r2.ts into the
# selected Convex cloud deployment with `npx convex env set`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_API=

# A separate private bucket is required for assessment source audio/images.
# Never point these names at the public custom-domain bucket above. These three
# values belong in the selected Convex deployment.
R2_ASSESSMENT_BUCKET_NAME=
R2_ASSESSMENT_ACCESS_KEY_ID=
R2_ASSESSMENT_SECRET_ACCESS_KEY=

# Development-only public bucket URL. Production must override it with a
# custom-domain NEXT_PUBLIC_MEDIA_BASE_URL.
R2_PUBLIC_DEV=

# Optional Cloudflare management token for operators. The application does not
# read or copy this token into Convex because S3 access uses the key pair above.
R2_AUTH_TOKEN=
