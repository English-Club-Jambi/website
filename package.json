{
  "name": "english-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3987",
    "build": "next build",
    "start": "next start -p 3987",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:backend": "vitest run tests/convex",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "convex:dev": "convex dev",
    "convex:push": "CONVEX_AGENT_MODE=anonymous convex dev --once",
    "admin:provision": "node scripts/admin-provision.mjs",
    "r2:check": "convex run r2:checkConnection '{}'",
    "r2:upload-reviewed": "node scripts/r2-upload-reviewed.mjs",
    "practice:seed": "node --experimental-strip-types --env-file=.env.local scripts/seed-ibt-practice.ts",
    "members:seed:dev": "node --experimental-strip-types --env-file=.env.local scripts/seed-development-data.ts --members-only",
    "data:seed:dev": "npm run practice:seed && node --experimental-strip-types --env-file=.env.local scripts/seed-development-data.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1117.0",
    "@convex-dev/auth": "0.0.95",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-select": "^2.3.7",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-drag-handle": "^3.30.3",
    "@tiptap/extension-drag-handle-react": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "convex": "1.45.0",
    "culori": "^4.0.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/culori": "^4.0.1",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "convex-test": "0.0.56",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
